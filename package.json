{
  "name": "@kne/fastify-live-components-site",
  "version": "0.1.9",
  "description": "Fastify 插件：为 LiveComponentEditor 提供远程站点文件树与短链访问管理",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "mocha --exit test/**/*.test.js",
    "test:coverage": "nyc --reporter=html --reporter=text mocha test/**/*.test.js --timeout 10000"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-live-components-site.git"
  },
  "keywords": [
    "fastify",
    "live-components",
    "file-tree",
    "shorten",
    "fastify-plugin"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-live-components-site/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-live-components-site#readme",
  "dependencies": {
    "@kne/load-npm-info": "^0.1.8",
    "@kne/md-doc": "^0.1.24",
    "ai": "^7.0.37",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@kne/fastify-account": "*",
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "@kne/fastify-shorten": "*",
    "fastify-plugin": ">=5"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/sensible": "^6.0.4",
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^3.0.6",
    "@kne/fastify-shorten": "^1.0.16",
    "chai": "^6.2.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.3",
    "nyc": "^17.1.0",
    "prettier": "^3.2.5",
    "qs": "^6.14.0",
    "sqlite3": "^5.1.7"
  }
}
